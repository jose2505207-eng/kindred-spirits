# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never hold a real key.

# Supabase dashboard -> Project Settings -> API Keys. The publishable key is
# meant to ship in the app bundle; RLS limits everything it can reach.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# true: no accounts, the seeded fixture profiles and in-memory messages — the
# build for a client review. Anything else: the real backend.
VITE_DEMO_MODE=false

# Never put a secret key in a VITE_ variable: Vite bundles every one of them.
# scripts/upload-card-art.mjs reads SUPABASE_URL and SUPABASE_SECRET_KEY from
# a separate untracked file instead (node --env-file=.env.upload ...).
